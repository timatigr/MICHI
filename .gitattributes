# Shell-скрипты в Docker-образе должны иметь LF — иначе shebang ломается
# в Linux-контейнере («no such file or directory»).
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
# В Dockerfile CRLF может поломать продолжения строк (`\`) — держим LF.
Dockerfile text eol=lf
# Шрифты бинарные: явно отключаем нормализацию EOL (защита woff2 от порчи).
*.woff2 binary
*.woff binary
# Прегенерированная озвучка (tts_baked/) — тоже бинарь.
*.mp3 binary
